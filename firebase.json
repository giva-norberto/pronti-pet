{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "pronti-app/**",
      "service-account.json",
      "*.log",
      ".env"
    ],
    "redirects": [
      {
        "source": "/tiktok",
        "destination": "/apresentacao.html?utm_source=tiktok&utm_medium=bio&utm_campaign=lancamento",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/:slug",
        "destination": "/vitrine.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
